include_guard(GLOBAL)

# helix_bindgen(<target> MODULE <name> [NAMESPACE <C# namespace>] [KIND Engine|NativeGame] HEADERS <h>...
#               [REFERENCES <h>...] [REFERENCE_NAMESPACE <C# namespace>] [INCLUDE_ROOTS <dir>...] [CS_OUTPUT <variable>]
#               [API])
# helix_bindgen(<target> MODULE <assembly name> ASSEMBLY <dll> PROXIES <C# type>... [REFERENCES <h>...]
#               [INCLUDE_ROOTS <dir>...] [CS_OUTPUT <variable>])
#
# Runs Helix.Bindgen (a C# tool, built with the .NET SDK of the build host, so cross builds for the Web and Android run
# it too) on the module's tagged headers. The generated C++ (registration in the scripting core, the function table,
# the layout checks) is added to <target>; the path of the generated C# is put into <variable> for the C# project
# that compiles it with Source/Runtime/HelixInterop.cs. REFERENCES are headers of other modules whose types the
# module's members use (known to the mapping, generated by their own modules), and REFERENCE_NAMESPACE the C# namespace
# of their types that name none (their module's NAMESPACE; the module's own when missing); headers below an INCLUDE_ROOT are
# included by their path relative to it. API also writes the module's C++ script API (value handles over the function
# table, <Namespace>/<Module>Api.h, its folder an include directory of <target> and what links it).
#
# The second form is C++ calling C#: typed C++ proxies of the C# classes PROXIES names, read from the compiled
# assembly. Their source is added to <target> (and their folder to its include path: <Module with _>.Proxies.h);
# CS_OUTPUT names the generated C# exports, compiled into an assembly that references the first.

set(HELIX_BINDGEN_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." CACHE INTERNAL "")
set(HELIX_BINDGEN_RUNTIME "${CMAKE_CURRENT_LIST_DIR}/../Source/Runtime/HelixInterop.cs" CACHE INTERNAL "")

function(helix_bindgen_tool out)
    find_program(HELIX_DOTNET NAMES dotnet HINTS "$ENV{HELIX_DOTNET_ROOT}" "$ENV{DOTNET_ROOT}" REQUIRED)
    set(artifacts "${CMAKE_BINARY_DIR}/HelixBindgen")
    set(dll "${artifacts}/bin/HelixBindgen/release/HelixBindgen.dll")
    if(NOT TARGET helix_bindgen_tool)
        file(GLOB_RECURSE sources CONFIGURE_DEPENDS "${HELIX_BINDGEN_ROOT}/Source/HelixBindgen/*.cs" "${HELIX_BINDGEN_ROOT}/Source/HelixBindgen/*.csproj")
        list(FILTER sources EXCLUDE REGEX "/(bin|obj)/")
        add_custom_command(
            OUTPUT "${dll}"
            COMMAND "${HELIX_DOTNET}" build "${HELIX_BINDGEN_ROOT}/Source/HelixBindgen/HelixBindgen.csproj" -c Release
                    --artifacts-path "${artifacts}" --nologo -v quiet
            DEPENDS ${sources}
            COMMENT "Building Helix.Bindgen")
        add_custom_target(helix_bindgen_tool DEPENDS "${dll}")
    endif()
    set(${out} "${dll}" PARENT_SCOPE)
endfunction()

function(helix_bindgen target)
    cmake_parse_arguments(ARG "API" "MODULE;NAMESPACE;REFERENCE_NAMESPACE;KIND;CS_OUTPUT;ASSEMBLY" "HEADERS;REFERENCES;INCLUDE_ROOTS;PROXIES" ${ARGN})
    if(NOT ARG_MODULE OR (NOT ARG_HEADERS AND NOT ARG_ASSEMBLY))
        message(FATAL_ERROR "helix_bindgen(${target}): MODULE and HEADERS (or ASSEMBLY and PROXIES) are needed")
    endif()
    if(NOT ARG_KIND)
        set(ARG_KIND NativeGame)
    endif()
    helix_bindgen_tool(tool)
    set(out_dir "${CMAKE_CURRENT_BINARY_DIR}/Bindings")
    set(outputs "")
    set(depends "")
    if(ARG_ASSEMBLY)
        string(MAKE_C_IDENTIFIER "${ARG_MODULE}" ident)
        set(h "${out_dir}/${ident}.Proxies.h")
        set(cpp "${out_dir}/${ident}.Proxies.cpp")
        set(cs "${out_dir}/${ident}.Exports.cs")
        set(rsp "${out_dir}/${ident}.Proxies.rsp")
        set(lines "--module\n${ARG_MODULE}\n--assembly\n${ARG_ASSEMBLY}\n--out-h\n${h}\n--out-cpp\n${cpp}\n--out-cs\n${cs}\n")
        foreach(t IN LISTS ARG_PROXIES)
            string(APPEND lines "--proxy\n${t}\n")
        endforeach()
        list(APPEND outputs "${h}")
        list(APPEND depends "${ARG_ASSEMBLY}")
        target_include_directories(${target} PRIVATE "${out_dir}")
    else()
        set(cpp "${out_dir}/${ARG_MODULE}.Bindings.cpp")
        set(cs "${out_dir}/${ARG_MODULE}.Bindings.cs")
        set(rsp "${out_dir}/${ARG_MODULE}.Bindgen.rsp")
        set(lines "--module\n${ARG_MODULE}\n--kind\n${ARG_KIND}\n--out-cpp\n${cpp}\n--out-cs\n${cs}\n")
        # API: the module's C++ script API, <Namespace>/<Module>Api.h below Bindings/Api (an include directory of the
        # target and of what links it).
        if(ARG_API)
            set(api_ns "${ARG_NAMESPACE}")
            if(NOT api_ns)
                set(api_ns "${ARG_MODULE}")
            endif()
            set(api "${out_dir}/Api/${api_ns}/${ARG_MODULE}Api.h")
            string(APPEND lines "--out-api\n${api}\n")
            list(APPEND outputs "${api}")
            target_include_directories(${target} PUBLIC $<BUILD_INTERFACE:${out_dir}/Api>)
        endif()
    endif()
    list(APPEND outputs "${cpp}" "${cs}")
    if(ARG_NAMESPACE)
        string(APPEND lines "--namespace\n${ARG_NAMESPACE}\n")
    endif()
    if(ARG_REFERENCE_NAMESPACE)
        string(APPEND lines "--reference-namespace\n${ARG_REFERENCE_NAMESPACE}\n")
    endif()
    foreach(h IN LISTS ARG_HEADERS)
        get_filename_component(h "${h}" ABSOLUTE)
        string(APPEND lines "--header\n${h}\n")
        list(APPEND depends "${h}")
    endforeach()
    foreach(h IN LISTS ARG_REFERENCES)
        get_filename_component(h "${h}" ABSOLUTE)
        string(APPEND lines "--reference\n${h}\n")
        list(APPEND depends "${h}")
    endforeach()
    foreach(dir IN LISTS ARG_INCLUDE_ROOTS)
        get_filename_component(dir "${dir}" ABSOLUTE)
        string(APPEND lines "--include-root\n${dir}\n")
    endforeach()
    file(MAKE_DIRECTORY "${out_dir}")
    file(CONFIGURE OUTPUT "${rsp}" CONTENT "${lines}")
    add_custom_command(
        OUTPUT ${outputs}
        COMMAND "${HELIX_DOTNET}" "${tool}" "@${rsp}"
        DEPENDS "${tool}" "${rsp}" ${depends}
        COMMENT "Bindings of ${ARG_MODULE}")
    target_sources(${target} PRIVATE "${cpp}")
    # A module's bindings are one file of many functions (past the default section limit of MSVC's objects).
    if(MSVC)
        set_source_files_properties("${cpp}" PROPERTIES COMPILE_OPTIONS "/bigobj")
    endif()
    if(ARG_CS_OUTPUT)
        set(${ARG_CS_OUTPUT} "${cs}" PARENT_SCOPE)
    endif()
endfunction()
