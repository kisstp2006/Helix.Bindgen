<Project Sdk="Microsoft.NET.Sdk">
  <!-- C# scripts of the tests: the sample module's generated bindings, the interop runtime, and C# classes that C++
       uses through generated proxies. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Scripts</RootNamespace>
    <AssemblyName>HelixBindgen.Scripts</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(HelixBindingsFile)" />
    <Compile Include="$(HelixInteropFile)" />
  </ItemGroup>
</Project>
